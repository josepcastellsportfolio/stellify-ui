{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/utils": ["./lib/utils.ts"],
      "@/lib/week-dates": ["./lib/week-dates.ts"],
      "@/lib/chart-formatters": ["./lib/chart-formatters.ts"],
      "@/hooks/use-series-toggle": ["./hooks/use-series-toggle.ts"],
      "@/components/ui/*": ["./components/ui/*"],
      "@/components/data-table": ["../registry/stellify/data-table.tsx"],
      "@/components/time-picker": ["../registry/stellify/time-picker.tsx"],
      "@/components/intelui/intelui-types": ["../registry/stellify/intelui-types.ts"],
      "@/components/intelui/intelui-tabs": ["../registry/stellify/intelui-tabs.tsx"],
      "@/components/intelui/intelui-conversation-list": ["../registry/stellify/intelui-conversation-list.tsx"],
      "@/components/intelui/intelui-chat-panel": ["../registry/stellify/intelui-chat-panel.tsx"],
      "@/components/nav-preview-card": ["../registry/stellify/nav-preview-card.tsx"],
      "@/components/mega-menu-panel": ["../registry/stellify/mega-menu-panel.tsx"],
      "@/components/animated-text": ["../registry/stellify/animated-text.tsx"],
      "@/hooks/use-focus-trap": ["../registry/stellify/use-focus-trap.ts"],
      "@/hooks/use-mega-menu": ["../registry/stellify/use-mega-menu.ts"],
      "@/hooks/use-prefers-reduced-motion": ["../registry/stellify/use-prefers-reduced-motion.ts"]
    }
  },
  "include": [
    "../registry/stellify/**/*.ts",
    "../registry/stellify/**/*.tsx",
    "./lib/**/*.ts",
    "./components/ui/**/*.tsx"
  ]
}
