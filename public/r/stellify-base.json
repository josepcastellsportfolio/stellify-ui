  "css": {
    "@import \"tw-animate-css\"": {},
    "[data-chart-palette=\"mono\"]": {
      "--chart-1": "oklch(0.36 0.09 126)",
      "--chart-2": "oklch(0.45 0.11 126)",
      "--chart-3": "oklch(0.54 0.12 126)",
      "--chart-4": "oklch(0.63 0.12 126)",
      "--chart-5": "oklch(0.72 0.1 126)"
    },
    ".dark [data-chart-palette=\"mono\"], .dark[data-chart-palette=\"mono\"]": {
      "--chart-1": "oklch(0.88 0.08 126)",
      "--chart-2": "oklch(0.78 0.11 126)",
      "--chart-3": "oklch(0.68 0.12 126)",
      "--chart-4": "oklch(0.58 0.11 126)",
      "--chart-5": "oklch(0.48 0.09 126)"
    },
    "@layer base": {
      "*, ::before, ::after, ::backdrop": {
        "border-color": "var(--border)"
      },
      "body": {
        "font-family": "var(--font-sans)",
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      },
      ":focus-visible": {
        "outline": "var(--focus-width) solid var(--focus)",
        "outline-offset": "var(--focus-offset)"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "*, *::before, *::after": {
          "transition-duration": "0.01ms !important",
          "animation-duration": "0.01ms !important",
          "animation-iteration-count": "1 !important"
        }
      }
    }
  },
